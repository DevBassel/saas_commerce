{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "project-plan",
  "instructions": [".opencode/instructions/plan-workflow.md"],
  "permission": {
    "pwf_*": "deny",
    "skill": {
      "planning-with-files": "deny"
    }
  },
  "agent": {
    "plan": {
      "description": "Native read-only analysis. Use /plan for persistent root plans.",
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "ask",
          "*.env.*": "ask",
          "*.env.example": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "question": "allow",
        "todowrite": "allow",
        "skill": {
          "*": "allow",
          "planning-with-files": "deny"
        },
        "external_directory": "ask",
        "doom_loop": "ask",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "plan_exit": "deny"
      }
    }
  }
}
