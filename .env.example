###########################################################
# Application
###########################################################
NODE_ENV=development
APP_NAME=saas_store
APP_PORT=4000
API_PREFIX=api
API_VERSION=v1
BOOTSTRAP_SUPER_ADMIN_EMAIL=platform@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=change_me_super_admin_password
BOOTSTRAP_SUPER_ADMIN_NAME=Super Admin
APP_ROOT_DOMAIN=localhost

###########################################################
# Database (PostgreSQL)
###########################################################
DB_NAME=saas_store
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_SYNCHRONIZE=true
DB_LOGGING=true
DB_SSL=false
TENANT_POOL_SIZE=5
# Default per-tenant storage quota in bytes (0.5 GiB below).
TENANT_STORAGE_CAPACITY_BYTES=524288000

###########################################################
# Cloudflare R2 Object Storage
###########################################################
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
# Generate in Cloudflare dashboard: R2 -> Manage API Tokens.
R2_SECRET_ACCESS_KEY=change_me_generate_a_r2_secret_access_key
R2_BUCKET=saas-store-uploads
# Public bucket / CDN base URL (no trailing slash).
R2_PUBLIC_URL=https://cdn.example.com
# Upload limits.
MAX_FILE_SIZE=5242880
MAX_PRODUCT_IMAGES=5

###########################################################
# JWT
# Generate with: openssl rand -hex 32
# Rotation: change secrets, all issued tokens are invalidated.
# Production boot fails if secrets are <32 chars or contain placeholders.
###########################################################
JWT_ACCESS_SECRET=change_me_generate_with_openssl_rand_hex_32_access
JWT_REFRESH_SECRET=change_me_generate_with_openssl_rand_hex_32_refresh
JWT_ACCESS_EXPIRES_IN=5h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=saas_store
JWT_AUDIENCE=saas_store

###########################################################
# Password Hashing
###########################################################
BCRYPT_ROUNDS=12

###########################################################
# Logging
###########################################################
LOG_LEVEL=debug

###########################################################
# CORS
###########################################################
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

