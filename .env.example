###########################################################
# docker-compose.yml values: API container + Redis.
#
# PostgreSQL is NOT managed by Compose. Point DB_* at a local or
# remote PostgreSQL 16 instance. From inside the API container the
# Docker host is reachable as host.docker.internal.
#
# Never put real credentials in this file; copy it to `.env` and fill
# in your own values. `.env` is gitignored.
###########################################################

NODE_ENV=production

# Port published on the host, and the interface it binds to.
APP_PORT=4000
APP_BIND_ADDRESS=0.0.0.0

# External PostgreSQL. DB_HOST defaults to host.docker.internal in Compose.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=saas_store
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis authentication. Generate a URL-safe value, e.g.:
#   openssl rand -hex 32
# A password with URL-reserved characters breaks REDIS_URL; use hex or
# percent-encode it.
REDIS_PASSWORD=replace_with_openssl_rand_hex_32

# Redis is published on host loopback only (for the documented local API
# workflow). Remove that mapping in deployments that do not need host access.
REDIS_HOST_PORT=6379
# Kept above the Redis memory limit; eviction uses allkeys-lru.
REDIS_MAXMEMORY=256mb
REDIS_MEM_LIMIT=320mb

# Optional build-time API base for the embedded Super Admin dashboard.
# Defaults to /api/v1 (same origin). Changing it requires an image rebuild.
# VITE_API_URL=/api/v1
