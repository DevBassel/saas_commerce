              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}", "role"]
            }
          },
          "response": []
        },
        {
          "name": "Grant Permissions To User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
