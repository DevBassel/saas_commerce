{
  "info": {
    "name": "Saas Store API",
    "description": "Schema-per-tenant RBAC API. Flow: run `Login Platform` first (sets {{platform_token}}), then `Register Store` (platform-admin only, Bearer {{platform_token}}, auto-sets tenant_slug + owner tokens). Set `tenant_slug` to target a tenant; Users/Roles/Permissions folders auto-send `x-tenant-slug`. Login stores access_token/refresh_token. List Users/Roles/Permissions/Tenants auto-set user_id/role_id/permission_id/tenant_id. Users/Roles/Permissions folders use Bearer {{access_token}}; Platform folder uses Bearer {{platform_token}} (tenant tokens are rejected on platform routes with 403). Custom role keys must match ^[a-z][a-z0-9_-]*$ ; uppercase keys are reserved system roles (create/rename to them -> 409, rename/delete of system roles -> 409). Create Permission key must be a valid permission key (409 if already seeded).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:4000/api/v1",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "platform_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "tenant_slug",
      "value": "",
      "type": "string"
    },
    {
      "key": "tenant_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "role_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "permission_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tenant-slug",
                "value": "{{tenant_slug}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"register success\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login Platform",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"platform@example.com\",\n  \"password\": \"ChangeMe_123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login/platform",
              "host": ["{{base_url}}"],
              "path": ["auth", "login", "platform"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login platform ok\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set(\"platform_token\", json.access_token);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Register Store",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{platform_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Store Owner\",\n  \"email\": \"owner@example.com\",\n  \"password\": \"password123\",\n  \"storeName\": \"My Store\",\n  \"storeSlug\": \"my-store\",\n  \"subdomain\": \"my-store\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register-store",
              "host": ["{{base_url}}"],
              "path": ["auth", "register-store"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"register store success\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"tenant_slug\", \"my-store\");",
                  "    pm.collectionVariables.set(\"access_token\", pm.response.json().access_token);",
                  "    pm.collectionVariables.set(\"refresh_token\", pm.response.json().refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-tenant-slug",
                "value": "{{tenant_slug}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login ok\", function () {",
