###########################################################
# Application
###########################################################
NODE_ENV=development
APP_NAME=saas_store
APP_PORT=4000
API_PREFIX=api
API_VERSION=v1
BOOTSTRAP_SUPER_ADMIN_EMAIL=platform@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=change_me_super_admin_password
BOOTSTRAP_SUPER_ADMIN_NAME=Super Admin
APP_ROOT_DOMAIN=localhost

###########################################################
# Database (PostgreSQL)
###########################################################
DB_NAME=saas_store
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_SYNCHRONIZE=true
# Opt-in tenant-schema auto-sync. Tenant schemas (`tenant_<slug>`) only
# auto-create when NODE_ENV !== 'production'; set this to true to force it in
# production until a migrations system exists. Keep it false in steady state and
# only turn it on for the first successful provisioning.
DB_SYNCHRONIZE_TENANTS=false
DB_LOGGING=true
DB_SSL=false
TENANT_POOL_SIZE=5
TENANT_STORAGE_CAPACITY_BYTES=268435456 # 256 MB
TENANT_DB_CAPACITY_BYTES=268435456 # 256 MB
# Per-statement PostgreSQL timeout in milliseconds (pg statement_timeout).
# 0 disables it. Applies to both the public and every tenant pool.
DB_STATEMENT_TIMEOUT_MS=30000

###########################################################
# Cloudflare R2 Object Storage
###########################################################
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
# Generate in Cloudflare dashboard: R2 -> Manage API Tokens.
R2_SECRET_ACCESS_KEY=change_me_generate_a_r2_secret_access_key
R2_BUCKET=saas-store-uploads
# Public bucket / CDN base URL (no trailing slash).
R2_PUBLIC_URL=https://cdn.example.com
# Upload limits.
MAX_FILE_SIZE=5242880
MAX_PRODUCT_IMAGES=5

###########################################################
# JWT
# Generate with: openssl rand -hex 32
# Rotation: change secrets, all issued tokens are invalidated.
# Production boot fails if secrets are <32 chars or contain placeholders.
###########################################################
JWT_ACCESS_SECRET=change_me_generate_with_openssl_rand_hex_32_access
JWT_REFRESH_SECRET=change_me_generate_with_openssl_rand_hex_32_refresh
JWT_ACCESS_EXPIRES_IN=5h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=saas_store
JWT_AUDIENCE=saas_store

###########################################################
# Password Hashing
###########################################################
BCRYPT_ROUNDS=12

###########################################################
# Logging
###########################################################
LOG_LEVEL=debug

###########################################################
# Rate Limiting
###########################################################
THROTTLE_TTL=60
THROTTLE_LIMIT=100

###########################################################
# Response cache (Redis)
# Server-side only. All API responses still send Cache-Control: no-store.
#
# Redis is required at boot. When running the API from source against the
# Compose Redis, use the same password as the root `.env`:
#   REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379
# Inside Compose, `docker-compose.yml` overrides REDIS_URL and points it at
# the `redis` service hostname.
#
# With NODE_ENV=production, Joi rejects placeholder values for the JWT, R2,
# Stripe, and OTP secrets and requires JWT_ISSUER/JWT_AUDIENCE, so a file
# copied verbatim from this example will not boot until those are replaced.
###########################################################
CACHE_ENABLED=true
CACHE_MAX_ENTRY_BYTES=262144 # 256 KiB
CACHE_MAX_INFLIGHT=100
CACHE_OPERATION_TIMEOUT_MS=50
CACHE_PRODUCTS_TTL_SECONDS=30
CACHE_CATEGORIES_TTL_SECONDS=300
CACHE_PLANS_TTL_SECONDS=300
# Redis is the only cache store and is required at boot. `rediss://` enables
# TLS automatically; CACHE_REDIS_TLS is for a plain redis:// URL behind a proxy
# that terminates TLS.
# The safety TTL must outlive the longest entry TTL plus a loader; the store
# raises it automatically if this value is too small.
REDIS_URL=redis://localhost:6379
CACHE_REDIS_TLS=false
CACHE_REDIS_CONNECT_TIMEOUT_MS=1000
CACHE_REDIS_COMMAND_TIMEOUT_MS=50
CACHE_REDIS_SAFETY_TTL_SECONDS=600

###########################################################
# CORS
###########################################################
# Comma-separated exact browser origins. Origins on APP_ROOT_DOMAIN and any of
# its subdomains (any scheme/port) are additionally allowed, e.g.
# http://my-store.localhost:5174. In production that looks like
# https://example.com and https://<tenant>.example.com.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000
CORS_CREDENTIALS=true

###########################################################
# Payments (Stripe Connect, destination charges)
###########################################################

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:4000/api/v1/payments/stripe/webhook --events payment_intent.succeeded,payment_intent.payment_failed,payment_intent.canceled`
# (newer Stripe CLI requires an explicit event selector; use --all-snapshot to forward every classic event).
STRIPE_WEBHOOK_SECRET=
# Platform fee in basis points taken on each destination charge (0 = no fee).
STRIPE_APPLICATION_FEE_BPS=0
# Where Stripe Connect onboarding sends the owner back to (return) and where it
# restarts if the link expires (refresh). Fallbacks only: the API derives
# per-tenant URLs from the request Origin when it is a trusted dashboard origin.
STRIPE_ONBOARDING_RETURN_URL=http://localhost:5174/settings/payments?stripe=return
STRIPE_ONBOARDING_REFRESH_URL=http://localhost:5174/settings/payments

###########################################################
# Seeding
###########################################################
# Production seeding additionally requires this to be true AND the CLI --force
# flag. Leave false in production unless you are intentionally seeding.
SEED_ALLOW_PRODUCTION=false

###########################################################
# Email OTP
# Generate OTP_HASH_SECRET with: openssl rand -hex 32
###########################################################
OTP_LENGTH=6
OTP_EXPIRATION_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS=5
OTP_REQUEST_WINDOW_SECONDS=3600
OTP_HASH_SECRET=change_me_generate_a_random_otp_hmac_pepper_at_least_32
# Block password login until the email is verified. Keep false until the
# frontends handle verification; flip to true to enforce it.
OTP_REQUIRE_EMAIL_VERIFIED=false

###########################################################
# Email delivery
# EMAIL_PROVIDER: smtp | log | memory. Use `log` in local dev (never prints the
# code) and `memory` in tests. `smtp` requires SMTP_HOST/SMTP_PORT.
###########################################################
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=your@gmail.com
EMAIL_FROM_NAME=SaaS Store
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=NEW_APP_PASSWORD
SMTP_SECURE=false
