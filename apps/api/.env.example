###########################################################
# Application
###########################################################
NODE_ENV=development
APP_NAME=saas_store
APP_PORT=4000
API_PREFIX=api
API_VERSION=v1
BOOTSTRAP_SUPER_ADMIN_EMAIL=platform@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=change_me_super_admin_password
BOOTSTRAP_SUPER_ADMIN_NAME=Super Admin
APP_ROOT_DOMAIN=localhost

###########################################################
# Database (PostgreSQL)
###########################################################
DB_NAME=saas_store
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_SYNCHRONIZE=true
DB_LOGGING=true
DB_SSL=false
TENANT_POOL_SIZE=5
TENANT_STORAGE_CAPACITY_BYTES=268435456 # 256 MB

###########################################################
# Cloudflare R2 Object Storage
###########################################################
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
# Generate in Cloudflare dashboard: R2 -> Manage API Tokens.
R2_SECRET_ACCESS_KEY=change_me_generate_a_r2_secret_access_key
R2_BUCKET=saas-store-uploads
# Public bucket / CDN base URL (no trailing slash).
R2_PUBLIC_URL=https://cdn.example.com
# Upload limits.
MAX_FILE_SIZE=5242880
MAX_PRODUCT_IMAGES=5

###########################################################
# JWT
# Generate with: openssl rand -hex 32
# Rotation: change secrets, all issued tokens are invalidated.
# Production boot fails if secrets are <32 chars or contain placeholders.
###########################################################
JWT_ACCESS_SECRET=change_me_generate_with_openssl_rand_hex_32_access
JWT_REFRESH_SECRET=change_me_generate_with_openssl_rand_hex_32_refresh
JWT_ACCESS_EXPIRES_IN=5h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=saas_store
JWT_AUDIENCE=saas_store

###########################################################
# Password Hashing
###########################################################
BCRYPT_ROUNDS=12

###########################################################
# Logging
###########################################################
LOG_LEVEL=debug

###########################################################
# CORS
###########################################################
# Comma-separated exact browser origins. Origins on APP_ROOT_DOMAIN and any of
# its subdomains (any scheme/port) are additionally allowed, e.g.
# http://my-store.localhost:5174. In production that looks like
# https://example.com and https://<tenant>.example.com.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
CORS_CREDENTIALS=true

###########################################################
# Payments (Stripe Connect, destination charges)
# Keys are optional: when unset the payment endpoints return 503.
# Use Stripe test-mode keys locally. Never commit live secrets.
###########################################################
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:4000/api/v1/payments/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Platform application fee in basis points (100 = 1%).
STRIPE_APPLICATION_FEE_BPS=0
STRIPE_CONNECT_COUNTRY=US
STRIPE_ONBOARDING_RETURN_URL=http://localhost:5174/settings/payments
STRIPE_ONBOARDING_REFRESH_URL=http://localhost:5174/settings/payments

