# Base URL of the backend API (no trailing slash).
VITE_API_URL=https://api.example.com/api/v1

# Build-time tenant-resolution mode. Unset/empty/true = resolve the tenant from the
# first host label (subdomain mode, default). Only the literal string `false` turns
# subdomain mode off and enables apex `?tenant=<slug>` mode.
VITE_ALLOW_SUBDOMAIN=true

# Build-time apex root domain, used only when VITE_ALLOW_SUBDOMAIN=false to
# classify the host: `<label>.<root>` is a tenant, `<root>`/`www.<root>` is the apex
# (uses `?tenant=`). Ignored when subdomain mode is on. Defaults to `localhost`.
VITE_APP_ROOT_DOMAIN=localhost
