# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=NEXTAUTH_SECRET
# Backend Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000/api/v1
# Platform root domain. The apex (this value, or www.<value>) serves the platform
# landing/plans/register-store; <label>.<value> serves that tenant's storefront.
# Use the real apex in production (e.g. example.com); defaults to localhost.
NEXT_PUBLIC_APP_ROOT_DOMAIN=localhost
# Subdomain-based tenant resolution. Build-time only (inlined by Next), so a
# runtime change has no effect. Unset/empty/true = subdomain mode (default).
# Set to the literal "false" to serve tenants from the platform apex via the
# ?tenant=<slug> query parameter instead; a tenant subdomain still resolves.
NEXT_PUBLIC_ALLOW_SUBDOMAIN=true
# Public R2/CDN base URL (must match the API R2_PUBLIC_URL)
R2_PUBLIC_URL=
# Stripe publishable key; must match the API's STRIPE_PUBLISHABLE_KEY (same
# platform account). Safe to expose client-side.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
