# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=NEXTAUTH_SECRET
# Backend Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000/api/v1
# Tenant resolution (store is served per subdomain, e.g. demo.localhost:3000)
NEXT_PUBLIC_APP_ROOT_DOMAIN=localhost
# Public R2/CDN base URL (must match the API R2_PUBLIC_URL)
R2_PUBLIC_URL=
# Stripe publishable key; must match the API's STRIPE_PUBLISHABLE_KEY (same
# platform account). Safe to expose client-side.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
